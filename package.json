{
  "name": "industrial-multi-protocol-simulator",
  "version": "1.0.0",
  "description": "Industrial Protocol Studio",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "set \"ELECTRON_RUN_AS_NODE=\" && vite",
    "build": "tsc --noEmit && vite build",
    "build:unsigned": "set \"CSC_IDENTITY_AUTO_DISCOVERY=false\" && tsc --noEmit && vite build && electron-builder",
    "build:signed": "tsc --noEmit && vite build && electron-builder",
    "test": "vitest",
    "test:e2e": "playwright test",
    "package": "electron-builder",
    "electron": "set \"ELECTRON_RUN_AS_NODE=\" && electron ."
  },
  "dependencies": {
    "antd": "^5.12.0",
    "electron-log": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "serialport": "^12.0.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "playwright": "^1.41.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4"
  }
}
